# Kali Linux Configuration
# https://docs.linuxserver.io/images/docker-kali-linux/
# Usuario personalizado (por defecto: abc)
KALI_USER=admin

# Resolución del escritorio (recomendada para Mac: 1920x1080)
# Opciones: 1920x1080, 1680x1050, 1440x900, 2560x1440, 1280x720
CUSTOM_RES=1920x1080

# Contraseña para acceso web (REQUERIDO)
# Genera una contraseña segura:
# openssl rand -base64 32
KALI_PASSWORD=
